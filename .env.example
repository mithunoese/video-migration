# Video Migration Platform — Environment Variables
# Copy this file to .env and fill in your values
#
# cp .env.example .env

# ─── DATABASE (Neon) ──────────────────────────────────────────────────────────
# Get this from https://neon.tech → your project → Connection Details
# Format: postgresql://user:password@host/dbname?sslmode=require
POSTGRES_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── KALTURA ─────────────────────────────────────────────────────────────────
KALTURA_PARTNER_ID=
KALTURA_ADMIN_SECRET=
KALTURA_USER_ID=
KALTURA_SERVICE_URL=https://www.kaltura.com
# App Token auth (preferred over admin_secret for enterprise)
KALTURA_APP_TOKEN_ID=
KALTURA_APP_TOKEN=

# ─── ZOOM ────────────────────────────────────────────────────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
# Target API: "events" (IFRS) | "vm" (Indeed/Video Management) | "clips"
ZOOM_TARGET_API=events
ZOOM_HUB_ID=
ZOOM_VOD_CHANNEL_ID=

# ─── AWS S3 (LocalStack in Docker, real AWS in production) ───────────────────
AWS_S3_BUCKET=migration-staging
AWS_REGION=us-east-1
# LocalStack endpoint — leave empty for real AWS
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ─── DASHBOARD AUTH ──────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
ADMIN_USER=admin
# Generate with: python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# ─── PIPELINE ────────────────────────────────────────────────────────────────
BATCH_SIZE=10
MAX_CONCURRENCY=5
RETRY_ATTEMPTS=3
RETRY_DELAY=5
DOWNLOAD_DIR=/tmp/video-migration
LOG_LEVEL=INFO

# ─── OPTIONAL ────────────────────────────────────────────────────────────────
# Skip S3 staging — upload directly from Kaltura to Zoom
SKIP_S3=false
# Only stage files larger than this (MB). 0 = always stage.
S3_SIZE_THRESHOLD_MB=0
# AI transcription via faster-whisper (CPU, optional)
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_MODEL=base
TRANSCRIPTION_LANGUAGE=

# Dashboard port (default 8000)
DASHBOARD_PORT=8000
ENVIRONMENT=production
